# Copy to .env (backend reads backend/.env locally; docker-compose reads ./.env). Never commit .env.

ENVIRONMENT=development            # set to "production" to refuse the default SECRET_KEY
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=10080

# SQLite (zero setup, default) or PostgreSQL
DATABASE_URL=sqlite:///./storage/videoai.db
# DATABASE_URL=postgresql+psycopg2://videoai:videoai@localhost:5432/videoai

CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8
TRUST_PROXY=false                  # true behind nginx/a load balancer so per-IP limits use X-Forwarded-For

# Free-tier limits
RENDER_DAILY_LIMIT_USER=10
RENDER_DAILY_LIMIT_IP=25
MAX_SCENES=20
MAX_SCENE_CHARS=1000
MAX_TOTAL_CHARS=6000

# Rendering
WORKER_ENABLED=true                # false when running the worker as a separate process
RENDER_FPS=24
RENDER_SCALE=1.0                   # 1.0 = 1280x720; 0.5 renders ~4x faster at lower resolution
TTS_PROVIDERS=edge,gtts,espeak     # fallback order. edge/gtts need internet; espeak needs espeak-ng installed

# Pluggable lip-sync model (default "amplitude" = built-in mouth animation)
AVATAR_PROVIDER=amplitude
# AVATAR_PROVIDER=command
# AVATAR_COMMAND=python /opt/sadtalker/inference.py --source_image {image} --driven_audio {audio} --result_video {out}

# Optional: LLM summarisation for text/URL -> scenes (heuristic summariser used when empty)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# docker-compose only
POSTGRES_PASSWORD=videoai
